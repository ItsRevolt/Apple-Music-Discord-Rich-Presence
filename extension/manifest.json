{
  "manifest_version": 3,
  "name": "Apple Music → Discord Rich Presence",
  "version": "0.1.0",
  "description": "Reads the current Apple Music Web track and posts it to a local daemon for Discord RPC.",
  "action": {
    "default_title": "Apple Music → Discord"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "ws://127.0.0.1:9224/*",
    "https://music.apple.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "*://music.apple.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "applemusic-presence@example.com",
      "strict_min_version": "109.0"
    }
  }
}